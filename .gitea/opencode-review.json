{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_MODEL}",
  "enabled_providers": ["openai"],
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "deny",
    "bash": {
      "*": "deny",
      "git status": "allow",
      "git status --short": "allow",
      "git diff --name-only jumi/target...HEAD": "allow",
      "git diff --stat jumi/target...HEAD": "allow",
      "git diff --check jumi/target...HEAD": "allow",
      "git diff jumi/target...HEAD": "allow",
      "git log jumi/target..HEAD": "allow",
      "git log --oneline jumi/target..HEAD": "allow",
      "git log --oneline --decorate jumi/target..HEAD": "allow",
      "git log --oneline --decorate --graph jumi/target..HEAD": "allow",
      "git log --stat jumi/target..HEAD": "allow",
      "git log --patch jumi/target..HEAD": "allow",
      "git log -p jumi/target..HEAD": "allow",
      "git show HEAD": "allow",
      "git show --stat HEAD": "allow",
      "git show --name-only HEAD": "allow",
      "git show --name-status HEAD": "allow",
      "git show jumi/target": "allow",
      "git show --stat jumi/target": "allow",
      "git ls-files": "allow",
      "git rev-parse HEAD": "allow",
      "git rev-parse jumi/target": "allow",
      "git merge-base jumi/target HEAD": "allow",
      "git branch --show-current": "allow",
      "git branch -a": "allow",
      "git branch -r": "allow",
      "git remote -v": "allow",
      "*;*": "deny",
      "*&*": "deny",
      "*|*": "deny",
      "*`*": "deny",
      "*$(*": "deny",
      "*>*": "deny",
      "*<*": "deny"
    },
    "external_directory": "deny",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "deny",
    "skill": "deny",
    "doom_loop": "deny"
  }
}
