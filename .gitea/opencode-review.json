{
  "$schema": "https://opencode.ai/config.json",
  "model": "{env:OPENCODE_MODEL}",
  "small_model": "{env:OPENCODE_MODEL}",
  "enabled_providers": ["openai"],
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "deny",
    "bash": "deny",
    "external_directory": "deny",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "webfetch": "deny",
    "websearch": "deny",
    "lsp": "deny",
    "skill": "deny",
    "doom_loop": "deny"
  }
}
