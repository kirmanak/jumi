{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "snapshot": false,
  "provider": {
    "xai": {
      "models": {
        "grok-4.5": {
          "options": {
            "reasoningEffort": "high"
          }
        },
        "grok-4.6": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "openai": {
      "models": {
        "gpt-5.5": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "permission": {
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": "allow",
    "write": "allow",
    "bash": {
      "*": "allow"
    },
    "external_directory": "deny",
    "task": "allow",
    "todowrite": "allow",
    "question": "deny",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "skill": "allow",
    "doom_loop": "deny"
  }
}
