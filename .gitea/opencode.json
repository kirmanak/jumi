{
  "$schema": "https://opencode.ai/config.json",
  "model": "litellm/large",
  "small_model": "litellm/small",
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm.kirmanak.stream/v1",
        "apiKey": "{env:LITELLM_AI_KEY}"
      },
      "models": {
        "large": {
          "name": "LiteLLM (Large)",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          }
        },
        "small": {
          "name": "LiteLLM (Small)",
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    }
  },
  "agent": {
    "compaction": {
      "model": "litellm/small"
    }
  },
  "share": "disabled",
  "permission": {
    "external_directory": "allow",
    "doom_loop": "deny",
    "bash": "allow",
    "read": "allow",
    "question": "deny"
  }
}
