{
  "$schema": "https://opencode.ai/config.json",
  "small_model": "github-copilot/gpt-5-mini",
  "provider": {
    "opencode-go": {
      "options": {
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      }
    },
    "github-copilot": {
      "options": {
        "apiKey": "{env:COPILOT_GITHUB_KEY}"
      }
    }
  },
  "share": "disabled",
  "permission": {
    "external_directory": "allow",
    "doom_loop": "deny",
    "bash": "allow",
    "read": "allow"
  }
}