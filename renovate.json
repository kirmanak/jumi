{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitea\\/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Automerge patch and digest updates after required checks pass.",
      "matchUpdateTypes": [
        "patch",
        "digest"
      ],
      "automerge": true,
      "platformAutomerge": true,
      "ignoreTests": false
    },
    {
      "description": "oven-sh/bun tags releases as bun-v1.2.3, which github-releases cannot parse as semver.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "oven-sh/bun"
      ],
      "extractVersion": "^bun-v(?<version>.+)$"
    },
    {
      "description": "Keep the worker JDK on Temurin 21.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "eclipse-temurin",
        "public.ecr.aws/docker/library/eclipse-temurin"
      ],
      "allowedVersions": "/^21\\./"
    }
  ],
  "constraints": {
    "bun": "1.2.5"
  },
  "minimumReleaseAge": "3 days",
  "prCreation": "not-pending",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignoreTests": true
}
