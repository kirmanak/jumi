{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allDigest"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.gitea\\/tool-versions\\.env$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\n[A-Z_]+=(?<currentValue>[^\\s]+)"
      ]
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["digest"],
      "automerge": true
    }
  ],
  "minimumReleaseAge": "3 days",
  "prCreation": "not-pending",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "ignoreTests": true
}